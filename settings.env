# Settings for the GitHub workflows. Every workflow loads this file, so change values
# here, through a pull request. Plain KEY=value lines: no quotes, no spaces around =.
# Passwords and tokens are NOT here: they are repository secrets (PRESERVICA_USER,
# PRESERVICA_PASSWORD, GITLAB_TOKEN); see the README.

# ARKs
ARK_NAAN=32498

# Preservica API server and tenant. The public portal uni.access.preservica.com has no
# API. A wrong tenant fails with "incorrect.tenant".
PRESERVICA_HOST=us.preservica.com
PRESERVICA_TENANT=UNIOWA
# Indexed MODS fields that hold ARKs (comma-separated). Field names are listed in
# preservica/indexed_fields.csv in rodlibrary/Scripts.
ARK_FIELDS=mods.identifier

# GitLab redirect repository that receives redirects.csv and ark_master_list.csv.
GITLAB_URL=https://git.uni.edu
GITLAB_PROJECT=rod-library/redirects
GITLAB_BRANCH=main
GITLAB_REDIRECTS_PATH=redirects.csv
GITLAB_MASTER_LIST_PATH=ark_master_list.csv
