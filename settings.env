# Settings for the GitHub workflows and the redirect servers. Every workflow loads this
# file, and so does scripts/install_maps.sh on the servers, so change values here,
# through a pull request. Plain KEY=value lines: no quotes, no spaces around =.
# Passwords are NOT here: they are repository secrets (PRESERVICA_USER,
# PRESERVICA_PASSWORD); see the README.

# ARKs
ARK_NAAN=32498

# Preservica API server and tenant. The public portal uni.access.preservica.com has no
# API. A wrong tenant fails with "incorrect.tenant".
PRESERVICA_HOST=us.preservica.com
PRESERVICA_TENANT=UNIOWA
# Indexed MODS fields that hold ARKs (comma-separated). Field names are listed in
# preservica/indexed_fields.csv in rodlibrary/Scripts.
ARK_FIELDS=mods.identifier

# Redirects (scripts/build_map.py, arks/ark_manifest.py redirects)
# Old ScholarWorks hostname(s) allowed in dc_path, comma-separated.
DC_HOSTS=scholarworks.uni.edu
# Hostnames redirects may point to, comma-separated.
ALLOWED_TARGET_HOSTS=uni.access.preservica.com,digital.library.uni.edu
# Public portal that ARK redirects point to: .../portal/en-US/asset/sdb%3AIO%7C<uuid>
PRESERVICA_ACCESS_HOST=uni.access.preservica.com
