# Settings for the GitHub workflows. Every workflow loads this file, so change values
# here, through a pull request. Plain KEY=value lines: no quotes, no spaces around =.
# The Preservica user name and password are NOT here: they are repository secrets
# (PRESERVICA_USER, PRESERVICA_PASSWORD); see the README.

# Hosts that redirect targets may point to (validate.py rejects anything else).
ALLOWED_TARGET_HOSTS=uni.access.preservica.com,digital.library.uni.edu
DC_HOST=scholarworks.uni.edu
ARK_HOST=library.uni.edu
ARK_NAAN=32498
DC_OAI_URL=https://scholarworks.uni.edu/do/oai/

# Preservica API server and tenant (not secret). The public portal
# uni.access.preservica.com has no API. A wrong tenant fails with "incorrect.tenant".
PRESERVICA_HOST=us.preservica.com
PRESERVICA_TENANT=UNIOWA

# Where redirect targets point, and their pattern; fields are explained in
# scripts/match_preservica.py. CONFIRM against a real Access portal link before the
# first full refresh.
PRESERVICA_ACCESS_HOST=uni.access.preservica.com
PRESERVICA_TARGET_TEMPLATE=https://{access_host}/portal/en-US/{kind}/{sdb}
