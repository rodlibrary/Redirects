# /etc/dc-redirects/pull.env on the library.uni.edu server (chmod 600).
# Same as pull.env.example except for the smoke test, which checks ARKs only,
# because this server doesn't answer the legacy ScholarWorks URLs.
# GitLab server and project ID for https://git.uni.edu/rod-library/redirects
GITLAB_URL=https://git.uni.edu
PROJECT_ID=2499
# Project access token with the Reporter role and read_api scope (can be shared with
# the redirect server's, or a separate token so each can be revoked on its own).
GITLAB_TOKEN=glpat-REPLACE-ME
REF=main
JOB=build_maps
REDIRECT_ROOT=/etc/httpd/redirects
SMOKE_SERVER=https://127.0.0.1
SMOKE_HOST=library.uni.edu
SMOKE_ONLY=ark
SMOKE_INSECURE=0
MAX_DROP_PCT=2
KEEP=10
