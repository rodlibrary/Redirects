# /etc/dc-redirects/pull.env on the library.uni.edu server (chmod 600).
# Same as pull.env.example except for the smoke test, which checks ARKs only,
# because this server doesn't answer the legacy ScholarWorks URLs.
# The GitHub repository whose "maps" release holds redirect-maps.zip.
GITHUB_REPO=rodlibrary/redirects
# Fine-grained personal access token: resource owner rodlibrary, only this repository,
# Contents: Read-only. Use a separate token from the redirect server's, so each can be
# revoked on its own.
GITHUB_TOKEN=github_pat_REPLACE-ME
RELEASE_TAG=maps
ASSET=redirect-maps.zip
REDIRECT_ROOT=/etc/httpd/redirects
SMOKE_SERVER=https://127.0.0.1
SMOKE_HOST=library.uni.edu
SMOKE_ONLY=ark
SMOKE_INSECURE=0
MAX_DROP_PCT=2
KEEP=10
