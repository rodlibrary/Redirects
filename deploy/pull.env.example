# Copy to /etc/dc-redirects/pull.env and chmod 600 (it holds a token).
# GitLab server and project ID for https://git.uni.edu/rod-library/redirects
GITLAB_URL=https://git.uni.edu
PROJECT_ID=2499
# Project access token with the Reporter role and read_api scope.
GITLAB_TOKEN=glpat-REPLACE-ME
REF=main
JOB=build_maps
REDIRECT_ROOT=/etc/httpd/redirects
SMOKE_SERVER=https://127.0.0.1
# On the scholarworks.uni.edu redirect server (it answers both legacy URLs and ARKs):
SMOKE_HOST=scholarworks.uni.edu
SMOKE_ONLY=all
# The library.uni.edu server uses deploy/pull.env.library.example instead.
# Set to 1 only if the certificate on 127.0.0.1 can't be verified (e.g. internal CA not installed).
SMOKE_INSECURE=0
MAX_DROP_PCT=2
KEEP=10
