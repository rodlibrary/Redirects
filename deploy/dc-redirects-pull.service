# Install: copy both units to /etc/systemd/system/, then
#   systemctl daemon-reload && systemctl enable --now dc-redirects-pull.timer
# Run once by hand:   systemctl start dc-redirects-pull.service
# See results:        journalctl -u dc-redirects-pull.service
[Unit]
Description=Pull Digital Commons redirect maps from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/dc-redirects/pull.env
ExecStart=/opt/dc-redirects/pull_maps.sh
# Runs as root only so it can write under /etc/httpd/redirects; a dedicated user
# that owns REDIRECT_ROOT works too (Apache only needs to read it).
